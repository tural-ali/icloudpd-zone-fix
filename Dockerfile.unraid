ARG UPSTREAM_IMAGE=boredazfcuk/icloudpd:latest
FROM ${UPSTREAM_IMAGE}

USER root
COPY . /src/icloudpd
RUN /opt/icloudpd/bin/pip install --no-cache-dir --force-reinstall /src/icloudpd \
    && sh /src/icloudpd/unraid/patch-sync-icloud.sh /usr/local/bin/sync-icloud.sh \
    && ash /src/icloudpd/unraid/test-resolve-library-list.sh /usr/local/bin/sync-icloud.sh \
    && mv /opt/icloudpd/bin/icloudpd /opt/icloudpd/bin/icloudpd.real \
    && install -m 755 /src/icloudpd/unraid/icloudpd-indexing-fallback.sh /opt/icloudpd/bin/icloudpd \
    && ash /src/icloudpd/unraid/test-indexing-fallback.sh /opt/icloudpd/bin/icloudpd /usr/local/bin/sync-icloud.sh \
    && /opt/icloudpd/bin/icloudpd --version \
    && rm -rf /src/icloudpd

LABEL org.opencontainers.image.source="https://github.com/tural-ali/icloudpd-zone-fix"
LABEL org.opencontainers.image.description="Unraid-compatible iCloudPD with moved-zone support and a fallback for libraries stuck in indexing"
